# Vite env vars must be prefixed with VITE_
# These are baked into the bundle at build time.
# On EC2, set these in deploy.env before building.

# --- This app ---
# QR order API (leave blank to use Vite proxy in dev)
# VITE_QR_ORDER_API_URL=http://localhost:5010

# --- Other frontends (optional, if this app links out) ---
# POS web app (if QR order links back to POS)
VITE_POS_URL=http://localhost:5173

# Admin portal (if QR order links to admin)
VITE_ADMIN_URL=http://localhost:5174

# Public marketing site (if QR order has links to public site)
VITE_PUBLIC_WEB_URL=http://localhost:5175
