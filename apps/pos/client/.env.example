# Vite env vars must be prefixed with VITE_
# These are baked into the bundle at build time.
# On EC2, set these in deploy.env before building.

# --- This app ---
# POS API base URL (leave blank to use Vite proxy in dev)
# VITE_API_URL=http://localhost:5000/api

# --- Links to other frontends (REQUIRED for cross-app navigation) ---
# Admin portal — avatar menu, subscription blocked, QR add-on upsell
# This must match your production admin portal deployment URL
VITE_ADMIN_URL=http://localhost:5174

# Guest table-order SPA — QR codes must point here, NEVER at the POS URL
# This must match your production QR order deployment URL (typically separate from POS)
VITE_QR_ORDER_WEB_ORIGIN=http://localhost:5180

# Public marketing site (optional)
VITE_PUBLIC_WEB_URL=http://localhost:5175

# POS web app (optional, only if POS needs to link to itself externally)
VITE_POS_URL=http://localhost:5173

# Legacy aliases (prefer VITE_ADMIN_URL and VITE_QR_ORDER_WEB_ORIGIN)
# VITE_ADMIN_PORTAL_URL=http://localhost:5174
# VITE_PUBLIC_ORDER_PAGE_ORIGIN=http://localhost:5180
