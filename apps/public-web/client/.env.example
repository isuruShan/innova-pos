# Vite env vars must be prefixed with VITE_
# These are baked into the bundle at build time.

# --- This app ---
# Public web API (defaults to http://localhost:5002 in dev if unset)
# VITE_PUBLIC_WEB_API_URL=http://localhost:5002

# --- Links to other frontends (Sign in modal tiles) ---
VITE_ADMIN_URL=http://localhost:5174
VITE_POS_URL=http://localhost:5173

# Guest QR order SPA (optional)
# VITE_QR_ORDER_WEB_ORIGIN=http://localhost:5180

# This site's public URL (optional, for canonical links)
# VITE_PUBLIC_WEB_URL=http://localhost:5175
