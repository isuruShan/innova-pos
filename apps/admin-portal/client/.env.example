# Vite env vars must be prefixed with VITE_
# These are baked into the bundle at build time.
# On EC2, set these before building.

# --- This app ---
# Admin Portal API base URL (leave blank to use Vite proxy in dev)
# VITE_API_URL=http://localhost:5001/api

# --- Links to other frontends (required for cross-app navigation) ---
# POS web app — sidebar "Open POS", dashboard quick action
VITE_POS_URL=http://localhost:5173

# Public marketing site (optional, if you add links from admin)
# VITE_PUBLIC_WEB_URL=http://localhost:5175

# Guest QR order SPA (optional, if admin shows order links)
# VITE_QR_ORDER_WEB_ORIGIN=http://localhost:5180

# Hide Stripe/PayPal secret fields on superadmin Payment setup (shown by default)
# VITE_HIDE_PAYMENT_SECRETS=true
