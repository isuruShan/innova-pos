NODE_ENV=development
PORT=5001
SERVICE_NAME=admin-portal-server

# Same DB as other apps. For Atlas, paste mongodb+srv://... here (or use MONGODB_ATLAS_URI).
MONGO_URI=mongodb://127.0.0.1:27017/innovapos
JWT_SECRET=SAME_AS_ALL_SERVICES

UPLOAD_SERVICE_URL=http://localhost:3002
AUDIT_SERVICE_URL=http://localhost:3004

POS_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
ADMIN_PORTAL_URL=http://localhost:5174

# Subscription payments (optional — also configurable in superadmin Payment setup)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# Analytics ETL (anly_* collections — populated from completed orders)
ANLY_SYNC_ENABLED=true
ANLY_SYNC_INTERVAL_MS=300000
ANLY_BACKFILL_DAYS=90
ANLY_SYNC_BATCH_SIZE=2000
# Set false on secondary admin-server instances when running multiple nodes
ANLY_SYNC_LEADER=true

EMAIL_FROM=innovasolutionslk@gmail.com
# Gmail: create an app password in Google Account → Security → App passwords
EMAIL_APP_PASSWORD=ADMIN_NOTIFY_EMAIL

# Optional: any SMTP provider instead of Gmail (leave unset to use Gmail above)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
