# Copy to bootstrap.env in repo root OR /etc/innovapos/bootstrap.env on the VM.
# PM2 reads this when starting ecosystem.config.cjs — NOT from your SSH session exports.
# Do NOT put MONGO_URI here; that lives in Key Vault secret JSON.

CLOUD_PROVIDER=azure
SECRETS_PROVIDER=azure
STORAGE_PROVIDER=azure

AZURE_KEY_VAULT_URL=https://cafinity-dev-key.vault.azure.net/
AZURE_KEY_VAULT_SECRET_NAME=innovapos-production-env

# Optional: SECRETS_MERGE_MODE=override
