# Copy to deploy.env on the production server (repo root).
# Loaded by scripts/deploy-production.sh before Vite builds.
#
# RECOMMENDED: Store these values in Azure Key Vault secret instead of this file.
# Add VITE_* variables to your Key Vault secret (same secret as server runtime config).
# The deploy script will automatically fetch them if AZURE_KEY_VAULT_URL is configured
# in bootstrap.env or /etc/innovapos/bootstrap.env.
#
# This file is only needed if NOT using Azure Key Vault, or for local testing.

# ── Vite build-time URLs (baked into client bundles) ──
# These URLs are used for cross-app navigation and must be set before building client apps.
# Update these to match your production domain or IP address (or add to Key Vault secret).

# POS web app (cashier/manager UI) - served by pos-server (default port 5000)
VITE_POS_URL=http://3.210.65.252:5000

# Admin portal (merchant & super-admin) - served by admin-portal-server (default port 5001)
VITE_ADMIN_URL=http://3.210.65.252:5001

# Public marketing/signup site - served by public-web-server (default port 5002)
VITE_PUBLIC_WEB_URL=http://3.210.65.252:5002

# Guest QR order SPA - served by qr-order-server (default port 5010)
# Required for Café table QR codes in the POS manager UI (NOT the POS URL).
VITE_QR_ORDER_WEB_ORIGIN=http://3.210.65.252:5010

# API endpoints (optional, falls back to proxy in dev)
# VITE_API_URL=http://3.210.65.252:5000/api
# VITE_PUBLIC_WEB_API_URL=http://3.210.65.252:5002/api
# VITE_QR_ORDER_API_URL=http://3.210.65.252:5010
