# Copy to deploy.env on the production server (repo root).
# Loaded by scripts/deploy-production.sh before Vite builds.

# ── Azure VM bootstrap (also set in /etc/environment or PM2 host env) ──
# CLOUD_PROVIDER=azure
# AZURE_KEY_VAULT_URL=https://kv-innovapos-prod.vault.azure.net/
# AZURE_KEY_VAULT_SECRET_NAME=innovapos-production-env

# ── Vite build-time URLs (baked into client bundles) ──
# VITE_API_URL=https://your-pos-domain.com/api
# VITE_ADMIN_URL=https://admin.yourdomain.com
# VITE_PUBLIC_WEB_API_URL=https://www.yourdomain.com
# VITE_QR_ORDER_WEB_ORIGIN=https://order.yourdomain.com
